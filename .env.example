# ============================================
# Smart Home AI Agent — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!
#
# Legend:  [BẮT BUỘC] = phải có giá trị thật trước khi chạy
#          [TUỲ CHỌN] = có mặc định hợp lý, chỉ đổi khi cần

# ---- LLM Configuration ----
# Gọi là OPENAI_API_KEY vì OpenAI SDK đọc biến này — dùng được cho mọi provider
# OpenAI-compatible (Ollama, Azure, vLLM, ...) bằng cách đổi LLM_BASE_URL.
OPENAI_API_KEY=sk-your-key-here            # [BẮT BUỘC] nếu dùng LLM
LLM_PROVIDER=openai                        # [TUỲ CHỌN] openai | ollama | gemini
LLM_BASE_URL=                              # [TUỲ CHỌN] để trống = mặc định OpenAI
MODEL_NAME=                                # [BẮT BUỘC] nếu dùng LLM — mỗi người tự chọn
LLM_TEMPERATURE=0.2                        # [TUỲ CHỌN]
LLM_REASONING_EFFORT=medium                # [TUỲ CHỌN]
LLM_TIMEOUT_SECONDS=30                     # [TUỲ CHỌN]

# ---- Embedding (truy hồi ký ức dài hạn) ----
# Nhúng ngữ nghĩa cho EventStore/EventRetriever. KHÔNG thay thế Requirement Ledger:
# mạch hội thoại vẫn là state có cấu trúc, tất định. Dùng chung OPENAI_API_KEY ở trên.
# Tắt (hoặc không có key / LLM_DISABLED) → rơi về hashing embedding tất định, offline.
EMBEDDING_ENABLED=true                     # [TUỲ CHỌN]
EMBEDDING_MODEL=text-embedding-3-small     # [TUỲ CHỌN]
EMBEDDING_DIMENSIONS=1024                  # [TUỲ CHỌN] 0 = đầy đủ; 1024 đo tốt nhất/chi phí
EMBEDDING_SIMILARITY_FLOOR=0.30            # [TUỲ CHỌN] cosine của hai câu KHÔNG liên quan
EMBEDDING_TIMEOUT_SECONDS=10               # [TUỲ CHỌN]
#
# ---- Hoặc: Ollama local (chạy `ollama serve` + `ollama pull <model>` trước) ----
# ModelClient dùng SDK openai với base_url tuỳ chỉnh nên trỏ thẳng vào endpoint
# OpenAI-compatible của Ollama là chạy được, không cần code riêng.
# OPENAI_API_KEY=ollama          # bắt buộc khác rỗng, Ollama không kiểm tra giá trị
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen2.5:3b          # đổi theo model đã `ollama pull`
# LLM_TIMEOUT_SECONDS=90         # suy luận local chậm hơn API, cần timeout dài hơn
# LLM_PLANNING_MODEL=            # [TUỲ CHỌN] model mạnh hơn chỉ cho kịch bản đa bước
# LLM_PLANNING_REASONING_EFFORT=low
# LLM_PLANNING_TIMEOUT_SECONDS=40
LLM_MAX_RETRIES=1                          # [TUỲ CHỌN]
LLM_PROMPT_CACHE_ENABLED=true              # [TUỲ CHỌN]
LLM_PROMPT_CACHE_NAMESPACE=smarthome-semantic-v1
SEMANTIC_CACHE_TTL_SECONDS=1800             # [TUỲ CHỌN]
SEMANTIC_CACHE_MAX_ENTRIES=256              # [TUỲ CHỌN]
LLM_DISABLED=false                         # [TUỲ CHỌN] true = chỉ NLU rule-based
RUN_LIVE_LLM=false                         # [TUỲ CHỌN] true = cho phép gọi model thật

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db       # [TUỲ CHỌN] SQLite mặc định, chạy ngay
# Postgres (khi chạy docker-compose):
# DATABASE_URL=postgresql+psycopg://smarthome:smarthome@localhost:5432/smarthome

# ---- Auth ----
JWT_SECRET=doi-gia-tri-nay-truoc-khi-deploy-toi-thieu-32-ky-tu   # [BẮT BUỘC] khi production
JWT_EXPIRE_MINUTES=720                     # [TUỲ CHỌN]

# ---- Mã hoá dữ liệu cá nhân (mỗi hộ dẫn xuất khoá riêng từ khoá gốc này) ----
ENCRYPTION_MASTER_KEY=doi-gia-tri-nay-truoc-khi-deploy-toi-thieu-32-ky-tu  # [BẮT BUỘC] khi production

# ---- IoT bus ----
MQTT_ENABLED=false                         # [TUỲ CHỌN] false = bus in-process
MQTT_HOST=localhost                        # [TUỲ CHỌN]
MQTT_PORT=1883                             # [TUỲ CHỌN]
MQTT_USERNAME=                             # [TUỲ CHỌN]
MQTT_PASSWORD=                             # [TUỲ CHỌN]

# ---- Session memory ----
REDIS_URL=                                 # [TUỲ CHỌN] để trống = in-process TTL store
# REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600                   # [TUỲ CHỌN]

# ---- Ngưỡng automation theo ngữ cảnh ----
PM25_THRESHOLD=55                          # [TUỲ CHỌN]
AWAY_MINUTES_THRESHOLD=120                 # [TUỲ CHỌN]
HOT_TEMPERATURE_THRESHOLD=33               # [TUỲ CHỌN]
AUTOMATION_INTERVAL_SECONDS=30             # [TUỲ CHỌN]
AUTOMATION_ENABLED=true                    # [TUỲ CHỌN]

# Dữ liệu thời tiết/AQI realtime qua Open-Meteo (không cần API key).
# Tọa độ mặc định là trung tâm TP.HCM — đổi theo vị trí ngôi nhà.
ENVIRONMENT_REALTIME_ENABLED=true          # [TUỲ CHỌN]
ENVIRONMENT_AUTO_EXECUTE=true              # [TUỲ CHỌN]
ENVIRONMENT_LATITUDE=10.7769               # [TUỲ CHỌN] đổi theo vị trí nhà
ENVIRONMENT_LONGITUDE=106.7009             # [TUỲ CHỌN] đổi theo vị trí nhà
ENVIRONMENT_REFRESH_SECONDS=300            # [TUỲ CHỌN]
ENVIRONMENT_TIMEOUT_SECONDS=5              # [TUỲ CHỌN]
ENVIRONMENT_AQI_THRESHOLD=100              # [TUỲ CHỌN]
STRONG_WIND_THRESHOLD_KMH=45              # [TUỲ CHỌN]
HIGH_UV_THRESHOLD=8                        # [TUỲ CHỌN]

# ---- App Config ----
APP_ENV=development                        # [TUỲ CHỌN]
APP_PORT=8000                              # [TUỲ CHỌN]
APP_HOST=0.0.0.0                           # [TUỲ CHỌN]
CORS_ORIGINS=http://localhost:3000,http://localhost:5173  # [TUỲ CHỌN]

# ---- LangSmith tracing (opt-in; payload bị che mặc định) ----
# Free Developer plan: 5000 traces/tháng. Tự tắt nếu không có key.
# Đăng ký tại https://smith.langchain.com → Settings → API Keys.
LANGSMITH_TRACING=false                    # [TUỲ CHỌN]
LANGSMITH_API_KEY=                         # [TUỲ CHỌN] chỉ cần nếu bật tracing
LANGSMITH_PROJECT=smart-home-ai-agent      # [TUỲ CHỌN]
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=true                 # [TUỲ CHỌN]
LANGSMITH_HIDE_OUTPUTS=true                # [TUỲ CHỌN]
# ---- Frontend ----
VITE_API_URL=http://localhost:8000         # [TUỲ CHỌN]
